{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "outDir": "./",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["shared/**/*.ts", "butterfly-catcher/**/*.ts", "zombie-catcher/**/*.ts", "fishing-game/**/*.ts"],
  "exclude": ["node_modules"]
}
